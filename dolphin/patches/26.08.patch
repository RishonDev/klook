+++ b/src/quicklook.h
@@ -0,0 +1,47 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rishon Jonathan R
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QUICKLOOK_H
+#define QUICKLOOK_H
+
+#include <QObject>
+
+class KFileItem;
+class KFileItemList;
+class QWidget;
+
+/**
+ * Quick Look for Dolphin, backed by klook (https://github.com/RishonDev/klook).
+ *
+ * Space toggles a preview of the selected item. While it is open, the preview
+ * follows the selection, so the arrow keys keep working in the view as usual,
+ * and Escape closes it. klook shows the preview without taking keyboard focus.
+ */
+class QuickLook : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit QuickLook(QWidget *window);
+
+    void toggle(const KFileItemList &selection);
+    void followSelection(const KFileItemList &selection);
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private Q_SLOTS:
+    void slotShowingChanged(bool showing);
+
+private:
+    void show(const KFileItem &item);
+    void close();
+
+    QWidget *m_window;
+    bool m_showing = false;
+};
+
+#endif
