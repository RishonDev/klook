new file mode 100644
index 0000000..12ea0e7
--- /dev/null
+++ b/src/quicklook.cpp
@@ -0,0 +1,97 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rishon Jonathan R
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "quicklook.h"
+
+#include <KFileItem>
+
+#include <QApplication>
+#include <QDBusConnection>
+#include <QDBusConnectionInterface>
+#include <QDBusMessage>
+#include <QKeyEvent>
+#include <QProcess>
+#include <QWidget>
+
+namespace
+{
+const QString klookService = QStringLiteral("org.kde.klook");
+const QString klookPath = QStringLiteral("/Preview");
+const QString klookInterface = QStringLiteral("org.kde.klook.Preview");
+
+void callKlook(const QString &method, const QVariantList &arguments = {})
+{
+    QDBusMessage message = QDBusMessage::createMethodCall(klookService, klookPath, klookInterface, method);
+    message.setArguments(arguments);
+    QDBusConnection::sessionBus().asyncCall(message);
+}
+}
+
+QuickLook::QuickLook(QWidget *window)
+    : QObject(window)
+    , m_window(window)
+{
+    // Keeps m_showing in sync when the preview is closed from klook itself.
+    QDBusConnection::sessionBus()
+        .connect(klookService, klookPath, klookInterface, QStringLiteral("ShowingChanged"), this, SLOT(slotShowingChanged(bool)));
+    qApp->installEventFilter(this);
+}
+
+void QuickLook::toggle(const KFileItemList &selection)
+{
+    if (m_showing) {
+        close();
+    } else if (!selection.isEmpty()) {
+        show(selection.first());
+    }
+}
+
+void QuickLook::followSelection(const KFileItemList &selection)
+{
+    if (m_showing && !selection.isEmpty()) {
+        show(selection.first());
+    }
+}
+
+bool QuickLook::eventFilter(QObject *watched, QEvent *event)
+{
+    if (m_showing && event->type() == QEvent::KeyPress && QApplication::activeWindow() == m_window
+        && static_cast<QKeyEvent *>(event)->key() == Qt::Key_Escape) {
+        close();
+        return true;
+    }
+    return QObject::eventFilter(watched, event);
+}
+
+void QuickLook::slotShowingChanged(bool showing)
+{
+    m_showing = showing;
+}
+
+void QuickLook::show(const KFileItem &item)
+{
+    bool isLocal = false;
+    const QUrl url = item.mostLocalUrl(&isLocal);
+    if (!isLocal) {
+        return;
+    }
+    const QString path = url.toLocalFile();
+
+    if (QDBusConnection::sessionBus().interface()->isServiceRegistered(klookService)) {
+        callKlook(QStringLiteral("Show"), {path, false});
+    } else {
+        QProcess::startDetached(QStringLiteral("klook"), {QStringLiteral("--no-activate"), path});
+    }
+    // Set right away: a freshly started klook may announce itself before the
+    // ShowingChanged subscription has resolved its new bus name.
+    m_showing = true;
+}
+
+void QuickLook::close()
+{
+    callKlook(QStringLiteral("Close"));
+    m_showing = false;
+}
